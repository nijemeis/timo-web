ADMIN_PASSWORD="change-me"
# Transactional email via Resend. Empty = print emails to the console (dev).
RESEND_API_KEY=""
EMAIL_FROM="Timo <no-reply@example.com>"
# Allow the "dev: open the link" shortcut for these email domains even in production (comma separated).
DEMO_LOGIN_DOMAINS=""
