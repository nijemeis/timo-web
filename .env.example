DATABASE_URL="postgresql://user@localhost:5432/timo"
DIRECT_DATABASE_URL="postgresql://user@localhost:5432/timo"
AUTH_SECRET="random 32+ bytes"
APP_URL="http://localhost:3200"
# First system admin (created/updated by the seed; password login is for system admins only)
